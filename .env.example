# Copy to .env and adjust. Everything here is optional.

# Let agents move stories to Done themselves (default: false, only you close cards).
# AGENTS_CAN_CLOSE=false

# Show the real weather in the office windows (Open-Meteo, no API key needed).
# City-level coordinates are enough.
# OFFICE_LAT=51.507
# OFFICE_LON=-0.128
# OFFICE_PLACE=London
